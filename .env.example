DATABASE_URL=postgresql+asyncpg://profi_user:profi_password@db:5432/profi_db
# Alternative to DATABASE_URL above: leave DATABASE_URL blank and set these
# instead, and config.py assembles the connection string from them. Ignored
# whenever DATABASE_URL is set directly (as it is here).
POSTGRES_USER=profi_user
POSTGRES_PASSWORD=profi_password
POSTGRES_DB=profi_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production
# JWT signing — defaults shown are what the app uses if these are unset.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LLM_API_KEY=
# LLM (OpenAI) — AI roadmap. Off by default; roadmap falls back to templates.
# Set LLM_ENABLED=true only after the key is set and verified.
LLM_ENABLED=false
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=20
LLM_MAX_TOKENS=2000
# Both roadmap generators (goal + direction) are much bigger, higher-value
# generations — they do not fit the limits above and get a stronger model.
LLM_ROADMAP_TIMEOUT=150
LLM_ROADMAP_MAX_TOKENS=8000
LLM_ROADMAP_MODEL=gpt-4.1
LLM_TEMPERATURE=0.3

# Email / Resend (leave RESEND_API_KEY blank to log codes to console in dev)
RESEND_API_KEY=
EMAIL_FROM=

# Google OAuth (web sign-in) — from Google Cloud Console > APIs & Services >
# Credentials > OAuth 2.0 Client IDs > Web application. Add the frontend's
# origin(s) as an "Authorized JavaScript origin" there.
GOOGLE_CLIENT_ID=

# Local dev: generate self-signed certs before first run
# mkdir -p nginx/ssl && openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#   -keyout nginx/ssl/key.pem -out nginx/ssl/cert.pem -subj "/CN=localhost"
