DATABASE_URL=postgresql+asyncpg://profi_user:profi_password@db:5432/profi_db
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production
LLM_API_KEY=
# LLM (OpenAI) — AI roadmap. Off by default; roadmap falls back to templates.
# Set LLM_ENABLED=true only after the key is set and verified.
LLM_ENABLED=false
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=20
LLM_MAX_TOKENS=2000
# Both roadmap generators (goal + direction) are much bigger, higher-value
# generations — they do not fit the limits above and get a stronger model.
LLM_ROADMAP_TIMEOUT=150
LLM_ROADMAP_MAX_TOKENS=8000
LLM_ROADMAP_MODEL=gpt-4.1
LLM_TEMPERATURE=0.3

# Email / Resend (leave RESEND_API_KEY blank to log codes to console in dev)
RESEND_API_KEY=
EMAIL_FROM=

# Object storage (S3-compatible) — see .env.local for MinIO values used in
# local dev; set these to your real provider's values in prod.
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=profi-media
STORAGE_USE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=http://localhost/media

# University photo import (scripts/import_jinaq_university_photos.py)
SCRAPER_USER_AGENT=ProfyUniversityPhotoBot/1.0
SCRAPER_REQUEST_DELAY_SECONDS=1.0
SCRAPER_REQUEST_TIMEOUT_SECONDS=20
JINAQ_MEDIA_BASE_URL=

# Local dev: generate self-signed certs before first run
# mkdir -p nginx/ssl && openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#   -keyout nginx/ssl/key.pem -out nginx/ssl/cert.pem -subj "/CN=localhost"
