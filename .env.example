DATABASE_URL=postgresql+asyncpg://profi_user:profi_password@db:5432/profi_db
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production
LLM_API_KEY=
# LLM (OpenAI) — AI roadmap. Off by default; roadmap falls back to templates.
# Set LLM_ENABLED=true only after the key is set and verified.
LLM_ENABLED=false
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=20
LLM_MAX_TOKENS=2000
# Direction roadmap is a much bigger generation — it does not fit the limits above.
LLM_ROADMAP_TIMEOUT=150
LLM_ROADMAP_MAX_TOKENS=8000
LLM_TEMPERATURE=0.3

# Email / SMTP (leave blank to log codes to console in dev)
# For deliverability, send from a custom domain you control (e.g. via an ESP
# such as Resend / Amazon SES / Mailgun / Brevo) and configure SPF, DKIM and
# DMARC for that domain. Sending from a free @gmail.com account routes to spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Envelope + From address, e.g. noreply@profy.newlevelhub.kz
EMAIL_FROM=
# Display name shown in the inbox
EMAIL_FROM_NAME=Profy
# Optional reply address, e.g. support@newlevelhub.kz (blank = omit header)
EMAIL_REPLY_TO=

# Local dev: generate self-signed certs before first run
# mkdir -p nginx/ssl && openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#   -keyout nginx/ssl/key.pem -out nginx/ssl/cert.pem -subj "/CN=localhost"
