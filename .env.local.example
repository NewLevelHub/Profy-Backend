DATABASE_URL=postgresql+asyncpg://profi_user:profi_password@localhost:5432/profi_db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=local-dev-secret-key-change-in-prod

# University photos — filesystem backend (nginx serves /srv/media directly,
# no MinIO). The host folder is bind-mounted by docker-compose.yml; override
# its path with MEDIA_DIR if ../profyphoto is not where your photos live.
STORAGE_BACKEND=fs
STORAGE_FS_ROOT=/srv/media
STORAGE_PUBLIC_BASE_URL=http://localhost/media
SCRAPER_REQUEST_DELAY_SECONDS=1.0
# Real jinaq domain — confirmed serving /cdn/jinaq-media/... directly (not /app)
JINAQ_MEDIA_BASE_URL=https://jinaq.ai
