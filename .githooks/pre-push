#!/bin/sh
# PRO-429: before a push, re-point this branch's new Alembic migrations onto
# the base branch's head (scripts/migrations_fix.py). If it had to change
# something it commits the fix and stops the push, because git has already
# decided which commit to send — just run `git push` again.
. "$(git rev-parse --show-toplevel)/.githooks/lib.sh"

head_sha=$(git rev-parse HEAD)
pushes_head=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$head_sha" ] && pushes_head=1
done
# Pushing some other branch / a tag / a deletion — nothing checked out to fix.
[ "$pushes_head" = 1 ] || exit 0

run_migrations_fix fix --commit --hook pre-push
case $? in
  0) exit 0 ;;
  3)
    echo "[migrations] Миграции перевешены и закоммичены. Повторите: git push"
    exit 1
    ;;
  *)
    echo "[migrations] push остановлен — причина выше."
    echo "[migrations] В крайнем случае обойти: git push --no-verify (CI всё равно проверит)."
    exit 1
    ;;
esac
